{
  "name": "board-app",
  "version": "0.4.0",
  "description": "Event board application with SQLite backend and integrated TypeScript frontend",
  "main": "Backend/server.js",
  "scripts": {
    "build": "npm run build:be && npm run build:fe",
    "build:be": "tsc -p tsconfig.json",
    "build:fe": "tsc -p Frontend/tsconfig.json",
    "start": "node Backend/server.js",
    "dev:be": "npm run build:be && node Backend/server.js",
    "dev:fe": "node scripts/frontend-dev-server.js",
    "dev": "npm run dev:be",
    "seed": "npm run build:be && node Backend/db/seed.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "sqlite3": "^6.0.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.3.1",
    "@types/uuid": "^9.0.2",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.3"
  }
}
